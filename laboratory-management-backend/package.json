{
  "name": "why",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run swagger && nodemon",
    "dev:patient": "npm run swagger:patient && nodemon --exec \"node --loader ts-node/esm services/patientService/src/index.ts\"",
    "dev:testOrder": "nodemon --exec \"node --loader ts-node/esm services/testOrderService/src/index.ts\"",
  "dev:warehouse": "npm-run-all swagger:warehouse start:warehouse",
    "swagger": "tsx services/iam-service/src/swagger.ts",
    "swagger:patient": "tsx services/patientService/src/swagger.ts",
  "swagger:warehouse": "tsx services/warehouseService/src/swagger.ts",
  "start:warehouse": "nodemon --watch services/warehouseService/src --ext ts,json --exec \"node --loader ts-node/esm services/warehouseService/src/index.ts\"",
    "dev:all": "npm-run-all --parallel dev:patient dev:testOrder dev:warehouse dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.13.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-openapi-validator": "^5.6.0",
    "joi": "^18.0.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.0.1",
    "mongoose": "^8.19.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "redis": "^5.8.3",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
