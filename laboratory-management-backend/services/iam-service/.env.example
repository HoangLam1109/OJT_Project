# IAM Service Environment Configuration

# Database
MONGODB_URI=mongodb://localhost:27017/iam-service
DB_NAME=iam-service

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_EXPIRY=24h

# Server
PORT=3001
WEB_URL=http://localhost:3000

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ============================================
# CENTRALIZED LOGGING CONFIGURATION
# ============================================

# Logger Type: "http" | "noop"
# - "http": Send events to monitoringService via HTTP
# - "noop": Log events locally only (default for safety)
LOGGER_TYPE=noop

# MonitoringService Configuration (required if LOGGER_TYPE=http)
# Base URL of the monitoring service (without trailing slash)
MONITORING_SERVICE_URL=http://localhost:3005/api

# Optional: API key for authentication with monitoring service
# MONITORING_API_KEY=your-monitoring-api-key

# Optional: Request timeout in milliseconds (default: 5000)
# MONITORING_TIMEOUT=5000

# Optional: Maximum retry attempts for failed requests (default: 3)
# MONITORING_MAX_RETRIES=3

# ============================================
# NOTES ON CENTRALIZED LOGGING
# ============================================
# 
# The IAM service uses a ports-and-adapters pattern for logging:
# 
# 1. INDEPENDENCE: IAM service remains fully functional even if 
#    monitoringService is down or unreachable
# 
# 2. DUAL LOGGING: Events are logged both locally (auditLog) and 
#    centrally (monitoringService) for redundancy
# 
# 3. RESILIENCE: HTTP adapter includes:
#    - Automatic retries with exponential backoff
#    - Circuit breaker to prevent cascading failures
#    - Timeout protection
#    - Fire-and-forget pattern (never blocks business logic)
# 
# 4. CONFIGURATION:
#    - Start with LOGGER_TYPE=noop for development
#    - Switch to LOGGER_TYPE=http when monitoringService is ready
#    - If MONITORING_SERVICE_URL is not set, falls back to noop
# 
# 5. MONITORING SERVICE ENDPOINT:
#    - POST {MONITORING_SERVICE_URL}/event-logs
#    - Expects CreateEventLogPayload schema
#    - Returns 201 with event_id on success
