          "401": {
            "description": "Unauthorized - no refresh token provided or invalid token",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "number",
                  "example": 0
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
