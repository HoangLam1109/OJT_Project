{
  "swagger": "2.0",
  "info": {
    "version": "v1.0.0",
    "title": "Patient Service API",
    "description": "Patient Management Microservice for Laboratory Information Management System. Handles patient demographics, medical records, and access audit logs."
  },
  "host": "localhost:5001",
  "basePath": "/api",
  "tags": [
    {
      "name": "Patients",
      "description": "Patient management operations (requires authentication)"
    },
    {
      "name": "Patient Medical Records",
      "description": "Sensitive medical record operations for authorized personnel"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "securityDefinitions": {
    "apiKeyAuth": {
      "type": "apiKey",
      "in": "cookie",
      "name": "accessToken",
      "description": "JWT access token stored in HTTP-only cookie. Set automatically on login from IAM Service."
    },
    "internalApiKey": {
      "type": "apiKey",
      "in": "header",
      "name": "x-internal-api-key",
      "description": "Internal microservice API key. Required for create/update/delete patient endpoints."
    }
  },
  "paths": {
    "/patients/getAll/": {
      "get": {
        "tags": [
          "Patients"
        ],
        "description": "Get all patients with pagination, search and filters",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "default": 1
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "default": 10
          },
          {
            "name": "search",
            "in": "query",
            "type": "string"
          },
          {
            "name": "isActive",
            "in": "query",
            "type": "boolean"
          },
          {
            "name": "populateUser",
            "in": "query",
            "type": "boolean",
            "default": true
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/patients/viewDetail/{id}": {
      "get": {
        "tags": [
          "Patients"
        ],
        "description": "Get a single patient by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true
          },
          {
            "name": "populateUser",
            "in": "query",
            "type": "boolean",
            "default": true
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/patients/create/": {
      "post": {
        "tags": [
          "Patients"
        ],
        "description": "Create a new patient profile for an existing IAM user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "example": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "example": "661fd5f2eecf99292a1a1c1b"
                    },
                    "emergency_contact": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "example": "John Doe"
                        },
                        "phone": {
                          "type": "string",
                          "example": "+84-912345678"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        },
        "security": [
          {
            "internalApiKey": []
          },
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/patients/update/{id}": {
      "put": {
        "tags": [
          "Patients"
        ],
        "description": "Update patient details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "1c9933e3-a5dc-4e94-bcbf-3d634fb87dc3"
                },
                "emergency_contact": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "Nguyễn Văn B"
                    },
                    "phone": {
                      "type": "string",
                      "example": "+84-912345678"
                    }
                  }
                },
                "last_test_type": {
                  "type": "string",
                  "example": "Blood Test"
                },
                "is_active": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        },
        "security": [
          {
            "internalApiKey": []
          },
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/patients/delete/{id}": {
      "delete": {
        "tags": [
          "Patients"
        ],
        "description": "Delete a patient (soft delete by default)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "hard",
            "in": "query",
            "type": "boolean",
            "default": false
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        },
        "security": [
          {
            "internalApiKey": []
          },
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/patient-medical-records/": {
      "get": {
        "tags": [
          "Patient Medical Records"
        ],
        "description": "Get all patient medical records with optional filters and patient details",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "type": "integer",
            "default": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page",
            "type": "integer",
            "default": 10
          },
          {
            "name": "patientId",
            "in": "query",
            "description": "Filter by patient ID",
            "type": "string"
          },
          {
            "name": "recordCode",
            "in": "query",
            "description": "Filter by record code",
            "type": "string"
          },
          {
            "name": "includePatient",
            "in": "query",
            "description": "Include patient profile details",
            "type": "boolean",
            "default": true
          },
          {
            "name": "includeDeleted",
            "in": "query",
            "description": "Include soft-deleted records",
            "type": "boolean",
            "default": false
          }
        ],
        "responses": {
          "200": {
            "description": "Patient medical records retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "example": "uuid"
                      },
                      "patient_id": {
                        "type": "string",
                        "example": "patient-uuid"
                      },
                      "record_code": {
                        "type": "string",
                        "example": "MR202510090001"
                      },
                      "blood_type": {
                        "type": "string",
                        "example": "A+"
                      },
                      "allergies": {
                        "type": "string",
                        "example": "Penicillin"
                      },
                      "chronic_conditions": {
                        "type": "string",
                        "example": "Hypertension"
                      },
                      "current_medications": {
                        "type": "string",
                        "example": "Atorvastatin"
                      },
                      "medical_history": {
                        "type": "string",
                        "example": "Appendectomy - 2010"
                      },
                      "clinical_notes": {
                        "type": "string",
                        "example": "Patient showing good recovery"
                      },
                      "recent_test_summary": {
                        "type": "string",
                        "example": "CBC normal, HbA1c elevated"
                      },
                      "recent_instruments_used": {
                        "type": "string",
                        "example": "Sysmex XN-1000"
                      },
                      "recent_reagents_info": {
                        "type": "string",
                        "example": "Lot# RGT-2025-09-15"
                      },
                      "created_at": {
                        "type": "string",
                        "example": "2025-10-24T11:00:00Z"
                      },
                      "updated_at": {
                        "type": "string",
                        "example": "2025-10-24T11:00:00Z"
                      },
                      "created_by": {
                        "type": "string",
                        "example": "lab-user-uuid"
                      },
                      "updated_by": {
                        "type": "string",
                        "example": "lab-user-uuid"
                      },
                      "is_deleted": {
                        "type": "boolean",
                        "example": false
                      },
                      "deleted_at": {},
                      "deleted_by": {},
                      "patient": {
                        "type": "object",
                        "properties": {
                          "_id": {
                            "type": "string",
                            "example": "patient-uuid"
                          },
                          "user_id": {
                            "type": "string",
                            "example": "user-uuid"
                          },
                          "patient_code": {
                            "type": "string",
                            "example": "PT202510240001"
                          }
                        }
                      }
                    }
                  }
                },
                "total": {
                  "type": "number",
                  "example": 1
                },
                "page": {
                  "type": "number",
                  "example": 1
                },
                "totalPages": {
                  "type": "number",
                  "example": 1
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Patient Medical Records"
        ],
        "description": "Create a patient medical record for an existing patient",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "patient_id": {
                  "type": "string",
                  "example": "patient-uuid"
                },
                "blood_type": {
                  "type": "string",
                  "example": "A+"
                },
                "allergies": {
                  "type": "string",
                  "example": "Penicillin"
                },
                "chronic_conditions": {
                  "type": "string",
                  "example": "Hypertension"
                },
                "current_medications": {
                  "type": "string",
                  "example": "Atorvastatin"
                },
                "medical_history": {
                  "type": "string",
                  "example": "Appendectomy - 2010"
                },
                "clinical_notes": {
                  "type": "string",
                  "example": "Patient showing good recovery"
                },
                "recent_test_summary": {
                  "type": "string",
                  "example": "CBC normal, HbA1c elevated"
                },
                "recent_instruments_used": {
                  "type": "string",
                  "example": "Sysmex XN-1000"
                },
                "recent_reagents_info": {
                  "type": "string",
                  "example": "Lot# RGT-2025-09-15"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Medical record created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "record": {
                  "type": "object",
                  "properties": {
                    "_id": {
                      "type": "string",
                      "example": "uuid"
                    },
                    "patient_id": {
                      "type": "string",
                      "example": "patient-uuid"
                    },
                    "record_code": {
                      "type": "string",
                      "example": "MR202510090001"
                    },
                    "blood_type": {
                      "type": "string",
                      "example": "A+"
                    },
                    "created_at": {
                      "type": "string",
                      "example": "2025-10-24T11:00:00Z"
                    },
                    "updated_at": {
                      "type": "string",
                      "example": "2025-10-24T11:00:00Z"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Invalid input or business rule violation"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/patient-medical-records/{id}": {
      "put": {
        "tags": [
          "Patient Medical Records"
        ],
        "description": "Update a patient medical record by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Medical record ID"
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Patient Medical Records"
        ],
        "description": "Soft delete a patient medical record by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Medical record ID"
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    }
  }
}